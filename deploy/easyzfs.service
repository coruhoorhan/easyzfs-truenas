[Unit]
Description=EasyZFS — gestión ZFS del NAS (colector + PWA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=easyzfs
Group=easyzfs
EnvironmentFile=-/etc/easyzfs/env
ExecStart=/usr/local/bin/easyzfs
Restart=on-failure
RestartSec=5

# Huella y longevidad
MemoryMax=256M
LimitNOFILE=4096

# Hardening (la app ejecuta zpool/zfs/smartctl/lsblk/crontab vía sudoers
# limitado — ver deploy/easyzfs.sudoers y README). NO poner NoNewPrivileges=yes:
# sudo necesita el bit setuid para elevar privilegios.
ProtectSystem=full
ReadWritePaths=/var/lib/easyzfs
ProtectHome=yes
PrivateTmp=yes

# Solo si escucha en puerto <1024 (preferir puerto alto + proxy):
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
