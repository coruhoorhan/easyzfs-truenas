[Unit]
Description=zfsctl — gestión ZFS del NAS (colector + PWA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zfsctl
Group=zfsctl
EnvironmentFile=/etc/zfsctl/env
# PATH con los wrappers sudo de zpool/zfs/smartctl primero (ver deploy/bin/)
Environment="PATH=/usr/local/lib/zfsctl/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/local/bin/zfsctl
Restart=on-failure
RestartSec=5

# Huella y longevidad
MemoryMax=256M
LimitNOFILE=4096

# Hardening. OJO: NO poner NoNewPrivileges=yes — los wrappers necesitan sudo (setuid).
# La superficie root queda limitada por /etc/sudoers.d/zfsctl a 3 comandos concretos.
ProtectSystem=full
ReadWritePaths=/var/lib/zfsctl
ProtectHome=yes
PrivateTmp=yes

# Solo si escucha en puerto <1024 (preferir puerto alto + proxy):
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
