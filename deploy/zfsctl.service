[Unit]
Description=zfsctl — gestión ZFS del NAS (colector + PWA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zfsctl
Group=zfsctl
EnvironmentFile=/etc/zfsctl/env
ExecStart=/usr/local/bin/zfsctl
Restart=on-failure
RestartSec=5

# Huella y longevidad
MemoryMax=256M
LimitNOFILE=4096

# Hardening (la app ejecuta zpool/zfs/smartctl vía sudoers limitado — ver README)
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/var/lib/zfsctl
ProtectHome=yes
PrivateTmp=yes

# Solo si escucha en puerto <1024 (preferir puerto alto + proxy):
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
